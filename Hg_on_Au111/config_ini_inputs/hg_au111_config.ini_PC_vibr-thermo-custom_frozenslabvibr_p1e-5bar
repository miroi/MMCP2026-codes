[system]

vacuum_size = 18.0
surface_size = 4,4,6
lattice_constant = 4.08
n_frozen_layers = 2

# Number of bottom Au layers frozen ONLY for vibrational/thermochemical calculations.
# This does not affect geometry relaxation. Set to 0 for no vibrational freezing,
# or to the full slab layer count (6 here) to freeze the entire Au slab.
n_frozen_layers_vibrations = 6
#n_frozen_layers_vibrations = 2

adsorption_site = fcc
hg_height = 3.0

fmax_au = 0.01
fmax_hg = 0.005

[calculation]

mode = scan
single_temperature = 298.15
temperatures = 50,100,200,298.15,400,500,600

# Set true to find the temperature where ΔG_ads(T) = 0.
# The existing 'temperatures' values define the search interval.
calculate_g_ads_zero_temperature = true

# Hg pressure in bar, recommended for low pressure adsorptions
pressure = 1e-5

output_prefix = hg_au111

verbose = true
save_trajectories = true

optimizer = FIRE

[phonons]

# Vibrational calculation backend: 'custom' uses the project Hessian code;
# 'ase' uses ASE Vibrations for the finite-difference Hessian and modes.
#method = ase
method = custom
ase_vibration_nfree = 2

phonon_displacement = 0.005
frequency_cutoff_cm = 1.0

# Acoustic sum-rule correction is disabled because bottom Au layers are fixed.
acoustic = false
symmetrize = true
fail_on_imaginary = true

use_hg_projected_modes = true
hg_mode_projection_threshold = 0.20

[thermodynamics]

# Thermodynamics backend: 'custom' or 'ase'.
# 'custom' preserves the project implementation; 'ase' uses
# ASE HarmonicThermo + IdealGasThermo.
method = custom
#method = ase

include_zpe = true
gas_reference_pressure = 1.0
calculate_temperature_scan = false

[runtime]

cuda_clear_between_phonons = true

[model]

# Adjust this path if needed.
#path = /home/miroi/.cache/mace/mace-mp-0b3-medium.model
path = /home/milias/.cache/mace/checkpoints/mace-mp-0b3-medium.model
